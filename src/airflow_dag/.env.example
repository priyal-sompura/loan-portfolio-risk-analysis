# =====================================================
# Apache Airflow Configuration Template
# Copy this file to .env and fill in your values
# =====================================================

AIRFLOW_VERSION=2.9.3
AIRFLOW_HOME=/opt/airflow
AIRFLOW_UID=1000

AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here
AIRFLOW__WEBSERVER__SECRET_KEY=your_webserver_secret_key_here
AIRFLOW__API__AUTH_BACKENDS=airflow.api.auth.backend.basic_auth,airflow.api.auth.backend.session
AIRFLOW__WEBSERVER__BASE_URL=http://localhost:8080

POSTGRES_USER=airflow
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=airflow
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:your_postgres_password@postgres:5432/airflow

AIRFLOW_CONN_POSTGRES_DEFAULT=postgresql+psycopg2://postgres:your_password@host.docker.internal:5432/loan_portfolio_db
